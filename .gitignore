# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Logs
logs/
*.log
*.env
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ========================================
# Frontend (pnpm workspace: frontend-admin + frontend-public)
# ========================================

# Dependencies
node_modules/

# Build output
dist/
build/
!/scripts/build/
site/

# Cache
.npm/
.eslintcache
*.tsbuildinfo

# Frontend framework artifacts (各前端自带 .gitignore 也覆盖，这里冗余兜底)
.next/
.tanstack/
.vitest-attachments/

# Console 静态导出产物（frontend-public build 产物拷入，仅发布 CI 构建，不入库）
src/backend/api/static/console/

# Environment files - ignore all .env* except *.env*.example
.env*
!.env*.example

# Preview deployment runtime env files
deploy/vps-traefik/*.env
!deploy/vps-traefik/*.env.example

# Testing
coverage/

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Claude planning session archives (local state, not for VCS)
.local/state/gh/device-id

# Agent runner state (local only)
.agent-runner/
# KedaCode runner 会话记录仅保存在本机；纳入版本控制会让 Agent 执行改动工作树，
# 并导致独立验证的 clean-tree 门禁失败。崩溃恢复与阶段续传需要它保留在本地。
.iar/agent-runner/

# TOML 原子写的临时文件（同目录唯一命名，正常路径由 writer 清理）：只在进程被
# 强杀时可能残留，绝不该进版本控制——它会弄脏 clean-tree 门禁。
*.toml.tmp

# Realistic Validation evidence packages — local PRD flow (`just ai implement`).
# Commit only the text reports (*.md: verification-plan / evidence-report /
# verifier-report). Keep the manifest and raw artifacts (screenshots,
# recordings, captured output, large logs) local-only.
# Same principle as the KedaCode runner's
# .iar/evidence/: legacy raw evidence never enters code history (binary bloat + secret
# leakage in permanent git history). The verifier and check_prd_evidence.sh
# still run against the local files at implement time.
tasks/evidence/**
!tasks/evidence/**/
!tasks/evidence/**/*.md

# pytest-testmon SQLite cache
.testmondata*

# >>> kc (managed by `kc init`) >>>
# KedaCode-managed git worktrees (host-local)
.kc-worktrees/
# <<< kc <<<

# KedaCode runner local state (memory / skills / decisions / state)
.kedacode/

# KedaCode TOML 写回的跨进程锁（与 config.toml / .kedacode.toml 同目录，零字节）
*.toml.lock


# Agent
.workbuddy-ai/

# Tauri / Rust 构建产物与自动生成的 schema
/desktop/src-tauri/target/
/desktop/src-tauri/gen/schemas/
