+_IGNORED_REPO_ENTRIES: frozenset[str] = frozenset(
+    {
+        ".git",
+        ".venv",
+        "venv",
+        "node_modules",
+        "__pycache__",
+        ".pytest_cache",
+        ".mypy_cache",
+        ".ruff_cache",
+        ".tox",
+        ".iar",
+        ".agent-runner",
+        "dist",
+        "build",
+        ".DS_Store",
+    }
+)
