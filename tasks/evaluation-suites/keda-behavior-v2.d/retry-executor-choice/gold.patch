+    """
+    return replace(
+        fresh_issue,
+        lifecycle_overrides=previous_issue.lifecycle_overrides,
+        lifecycle_preset_overrides=previous_issue.lifecycle_preset_overrides,
+        explicit_executor_overrides=previous_issue.explicit_executor_overrides,
+    )
+
