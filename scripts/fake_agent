#!/usr/bin/env python3
"""RV fixture 用的假 agent 可执行器：只 fake 外部 agent 边界（PRD mock_boundary）。

被配置为 claude 的 ``bin``，run 档走 plain 协议调用。行为：
- 记录 ``start`` 探针（含时间戳、pid、从 argv 里正则出的 Issue 号），
- 睡眠 ``FAKE_AGENT_SLEEP`` 秒（默认 6，制造可观测的重叠窗口），
- 记录 ``end`` 探针，按 ``FAKE_AGENT_EXIT``（默认 0）退出。

探针写 JSONL 到 ``$FAKE_AGENT_PROBE``，用于计算任意时刻并发在跑峰值。
绝不进入代码 diff。"""

from __future__ import annotations

import json
import os
import re
import sys
import time
from pathlib import Path

PROBE_PATH = Path(os.environ["FAKE_AGENT_PROBE"])
SLEEP_SECONDS = float(os.environ.get("FAKE_AGENT_SLEEP", "6"))
EXIT_CODE = int(os.environ.get("FAKE_AGENT_EXIT", "0"))
_ISSUE_RE = re.compile(r"Issue\s*#?(\d+)", re.IGNORECASE)


def _append(event: str, issue_number: int | None) -> None:
    record = {
        "event": event,
        "ts": time.time(),
        "pid": os.getpid(),
        "issue": issue_number,
    }
    with PROBE_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record) + "\n")
        handle.flush()


def _issue_from_argv(argv: list[str]) -> int | None:
    for token in argv:
        match = _ISSUE_RE.search(token)
        if match:
            return int(match.group(1))
    return None


def main() -> None:
    issue_number = _issue_from_argv(sys.argv[1:])
    _append("start", issue_number)
    sys.stdout.write(f"fake agent start issue={issue_number}\n")
    sys.stdout.flush()
    commit_marker_value = os.environ.get("FAKE_AGENT_COMMIT_REQUEST_MARKER")
    commit_marker = Path(commit_marker_value) if commit_marker_value else None
    issue_commit_not_requested = commit_marker is None or not commit_marker.exists()
    if os.environ.get("FAKE_AGENT_COMMIT_REQUEST") == "1" and issue_commit_not_requested:
        worktree_path = Path.cwd()
        artifact_path = worktree_path / "rv-agent-output.txt"
        artifact_path.write_text(
            f"fake agent completed Issue #{issue_number}\n", encoding="utf-8"
        )
        commit_request_dir = worktree_path / ".agent-runner"
        commit_request_dir.mkdir(exist_ok=True)
        (commit_request_dir / "commit-request.json").write_text(
            json.dumps(
                {"commit_message": f"test(agent-runner): complete Issue #{issue_number}"},
                ensure_ascii=False,
            ),
            encoding="utf-8",
        )
        if commit_marker is not None:
            commit_marker.parent.mkdir(parents=True, exist_ok=True)
            commit_marker.write_text("issued\n", encoding="utf-8")
    time.sleep(SLEEP_SECONDS)
    _append("end", issue_number)
    sys.stdout.write(f"fake agent end issue={issue_number}\n")
    sys.exit(EXIT_CODE)


if __name__ == "__main__":
    main()
