#!/usr/bin/env python3
"""证据脚本用的假 ``gh``：只 fake 外部 GitHub CLI 边界（PRD mock_boundary）。

- 状态落在 ``$FAKE_GH_STATE/issues.json``，用 flock 串行化读写；
- 每次调用把 argv 与退出码追加到 ``$FAKE_GH_STATE/gh_calls.jsonl``；
- 只实现 kc 会用到的 ``gh`` 子命令，未识别的 argv **fail-loud 退出 70**；
- ``FAKE_GH_FAIL_LABEL_COUNT=1`` 时，对 ``agent/running`` 且 ``--state open``
  且 ``--limit == FAKE_GH_FAIL_COUNT_LIMIT`` 的计数查询返回失败（rv-5 注入）。
"""

from __future__ import annotations

import fcntl
import json
import os
import re
import sys
from pathlib import Path

STATE_DIR = Path(os.environ["FAKE_GH_STATE"])
STATE_PATH = STATE_DIR / "issues.json"
CALLS_PATH = STATE_DIR / "gh_calls.jsonl"
OWNER_REPO = "fake-owner/fake-repo"
FAIL_CODE = 127


def _load_state() -> dict:
    with STATE_PATH.open(encoding="utf-8") as handle:
        return json.load(handle)


def _mutate(fn) -> None:
    lock_path = STATE_DIR / "issues.lock"
    with lock_path.open("w") as lock_handle:
        fcntl.flock(lock_handle, fcntl.LOCK_EX)
        try:
            state = _load_state()
            result = fn(state)
            STATE_PATH.write_text(json.dumps(state, ensure_ascii=False), encoding="utf-8")
        finally:
            fcntl.flock(lock_handle, fcntl.LOCK_UN)
    if result is not None:
        _emit(result)


def _emit(payload) -> None:
    if isinstance(payload, str):
        sys.stdout.write(payload)
        if not payload.endswith("\n"):
            sys.stdout.write("\n")
    else:
        sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")


def _log_call(argv: list[str], code: int) -> None:
    with (STATE_DIR / "gh_calls.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            with CALLS_PATH.open("a", encoding="utf-8") as handle:
                handle.write(json.dumps({"argv": argv, "code": code}) + "\n")
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def _flag_value(argv: list[str], flag: str) -> str | None:
    if flag in argv:
        idx = argv.index(flag)
        if idx + 1 < len(argv):
            return argv[idx + 1]
    return None


def _issue_summary(issue: dict) -> dict:
    return {
        "number": issue["number"],
        "title": issue["title"],
        "url": issue["url"],
        "body": issue.get("body", ""),
        "labels": [{"name": name} for name in issue.get("labels", [])],
        "state": issue.get("state", "OPEN"),
    }


def _matches(issue: dict, label: str | None, state: str) -> bool:
    if state == "open" and issue.get("state", "OPEN").upper() != "OPEN":
        return False
    if state == "closed" and issue.get("state", "OPEN").upper() != "CLOSED":
        return False
    if label is not None and label not in issue.get("labels", []):
        return False
    return True


def _maybe_fail_running_count(argv: list[str]) -> bool:
    if os.environ.get("FAKE_GH_FAIL_LABEL_COUNT") != "1":
        return False
    label = _flag_value(argv, "--label")
    state = _flag_value(argv, "--state")
    limit = _flag_value(argv, "--limit")
    fail_limits = set((os.environ.get("FAKE_GH_FAIL_COUNT_LIMIT") or "").split(","))
    if label == "agent/running" and state == "open" and limit in fail_limits:
        return True
    return False


def _maybe_hide_running_count(argv: list[str]) -> bool:
    """Inject a stale empty result for the live running-count query (rv-1 control)."""
    if os.environ.get("FAKE_GH_EMPTY_RUNNING_COUNT") != "1":
        return False
    label = _flag_value(argv, "--label")
    state = _flag_value(argv, "--state")
    limit = _flag_value(argv, "--limit")
    count_limit = os.environ.get("FAKE_GH_EMPTY_RUNNING_LIMIT")
    return label == "agent/running" and state == "open" and limit == count_limit


def _issue_number(argv: list[str]) -> int:
    """取 issue 子命令的位置编号（固定紧跟子命令，位于 argv[2]）。"""
    if len(argv) > 2 and argv[2].isdigit():
        return int(argv[2])
    raise ValueError(f"no issue number in {argv!r}")


def _cmd_issue_list(argv: list[str]) -> None:
    if _maybe_fail_running_count(argv):
        sys.stderr.write("gh: injection: cannot count agent/running\n")
        _log_call(argv, FAIL_CODE)
        sys.exit(FAIL_CODE)
    if _maybe_hide_running_count(argv):
        _emit([])
        return
    label = _flag_value(argv, "--label")
    state = _flag_value(argv, "--state") or "open"
    limit = int(_flag_value(argv, "--limit") or "30")

    def read(state_obj: dict):
        rows = [
            _issue_summary(issue)
            for issue in sorted(
                (item for item in state_obj["issues"].values() if item.get("number") is not None),
                key=lambda item: -item["number"],
            )
            if _matches(issue, label, state)
        ][:limit]
        return rows

    _mutate(read)


def _cmd_issue_view(argv: list[str]) -> None:
    number = _issue_number(argv)
    want_comments = "--comments" in argv
    json_fields = (_flag_value(argv, "--json") or "").split(",")

    def read(state_obj: dict):
        issue = state_obj["issues"].get(str(number))
        if issue is None:
            sys.stderr.write(f"gh: issue #{number} not found\n")
            _log_call(argv, FAIL_CODE)
            sys.exit(FAIL_CODE)
        summary = _issue_summary(issue)
        if want_comments or "comments" in json_fields:
            summary["comments"] = issue.get("comments", [])
        if json_fields and "comments" not in json_fields and not want_comments:
            summary = {key: value for key, value in summary.items() if key in json_fields}
        return summary

    _mutate(read)


def _cmd_issue_edit(argv: list[str]) -> None:
    number = _issue_number(argv)
    body_file = _flag_value(argv, "--body-file")
    add = [argv[i + 1] for i, token in enumerate(argv) if token == "--add-label"]
    remove = [argv[i + 1] for i, token in enumerate(argv) if token == "--remove-label"]

    def update(state_obj: dict):
        issue = state_obj["issues"].setdefault(
            str(number),
            {
                "number": number,
                "title": f"Issue {number}",
                "url": f"https://github.com/{OWNER_REPO}/issues/{number}",
                "body": "",
                "labels": [],
                "state": "OPEN",
                "comments": [],
            },
        )
        labels = list(issue.get("labels", []))
        for name in remove:
            if name in labels:
                labels.remove(name)
        for name in add:
            if name not in labels:
                labels.append(name)
        issue["labels"] = labels
        if body_file:
            issue["body"] = Path(body_file).read_text(encoding="utf-8")
        return _issue_summary(issue)

    _mutate(update)


def _cmd_issue_comment(argv: list[str]) -> None:
    number = _issue_number(argv)
    body_file = _flag_value(argv, "--body-file")
    body = Path(body_file).read_text(encoding="utf-8") if body_file else ""

    def append(state_obj: dict):
        issue = state_obj["issues"].setdefault(
            str(number),
            {
                "number": number,
                "title": f"Issue {number}",
                "url": f"https://github.com/{OWNER_REPO}/issues/{number}",
                "body": "",
                "labels": [],
                "state": "OPEN",
                "comments": [],
            },
        )
        comment_id = state_obj["next_comment_id"]
        state_obj["next_comment_id"] += 1
        issue.setdefault("comments", []).append(
            {
                "id": comment_id,
                "url": f"https://github.com/{OWNER_REPO}/issues/{number}#issuecomment-{comment_id}",
                "body": body,
                "author": {"login": "rv-bot"},
                "viewerDidAuthor": True,
            }
        )
        return None

    _mutate(append)


def _cmd_issue_create(argv: list[str]) -> None:
    title = _flag_value(argv, "--title") or "New issue"
    body_file = _flag_value(argv, "--body-file")
    body = Path(body_file).read_text(encoding="utf-8") if body_file else ""
    labels = [argv[i + 1] for i, token in enumerate(argv) if token == "--label"]

    def create(state_obj: dict):
        number = state_obj["next_issue"]
        state_obj["next_issue"] += 1
        url = f"https://github.com/{OWNER_REPO}/issues/{number}"
        state_obj["issues"][str(number)] = {
            "number": number,
            "title": title,
            "url": url,
            "body": body,
            "labels": labels,
            "state": "OPEN",
            "comments": [],
        }
        return url

    _mutate(create)


def _cmd_label(argv: list[str]) -> None:
    # gh label create/list — 幂等接受，不改变 issue 状态。
    if "list" in argv:
        _mutate(lambda state_obj: [])
    else:
        _emit("")


def _cmd_api(argv: list[str]) -> None:
    joined = " ".join(argv)
    if "/collaborators/" in joined and "/permission" in joined:
        _emit(
            {
                "permission": "write",
                "role_name": "write",
                "user": {"login": "rv-bot", "permissions": {"triage": True, "push": True}},
            }
        )
        return
    _emit({})


def _cmd_pr(argv: list[str]) -> None:
    sub = argv[1] if len(argv) > 1 else ""
    if sub == "list":
        _mutate(lambda state_obj: [])
    elif sub == "view":
        sys.stderr.write("gh: no pull requests found\n")
        _log_call(argv, 1)
        sys.exit(1)
    elif sub == "create":
        _emit(f"https://github.com/{OWNER_REPO}/pull/1")
    elif sub in ("merge", "ready", "edit", "close", "comment"):
        _emit("")
    else:
        _emit("")


def _cmd_repo(argv: list[str]) -> None:
    _emit({"nameWithOwner": OWNER_REPO})


def main() -> None:
    # 运行器以 subprocess 执行 ``gh <sub...>``：sys.argv[0] 是本脚本路径，参数从
    # sys.argv[1:] 起为 ``["issue", "list", ...]``（没有额外的 "gh" token）。
    argv = sys.argv[1:]
    group = argv[0] if argv else ""
    try:
        if group == "issue":
            sub = argv[1]
            if sub == "list":
                _cmd_issue_list(argv)
            elif sub == "view":
                _cmd_issue_view(argv)
            elif sub == "edit":
                _cmd_issue_edit(argv)
            elif sub == "comment":
                _cmd_issue_comment(argv)
            elif sub == "create":
                _cmd_issue_create(argv)
            else:
                raise KeyError(sub)
        elif group == "label":
            _cmd_label(argv)
        elif group == "api":
            _cmd_api(argv)
        elif group == "pr":
            _cmd_pr(argv)
        elif group == "repo":
            _cmd_repo(argv)
        elif group == "auth":
            _emit("")
        elif group == "status":
            _emit("")
        else:
            raise KeyError(group)
    except (KeyError, IndexError) as exc:
        sys.stderr.write(f"fake gh: unhandled argv {sys.argv[1:]!r} ({exc})\n")
        _log_call(sys.argv[1:], 70)
        sys.exit(70)
    _log_call(sys.argv[1:], 0)


if __name__ == "__main__":
    main()
