{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "menubar-panel",
  "description": "允许菜单栏状态面板从本机 Console 页面切换窗口模式、打开完整控制台并发送通知。",
  "windows": ["main", "console"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "allow-open-console-window",
    "allow-open-external-url",
    "dialog:allow-message",
    "allow-notify-task",
    "allow-set-panel-pinned",
    "allow-hide-panel"
  ]
}
