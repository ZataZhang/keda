{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KedaCode",
  "version": "0.1.0",
  "identifier": "com.kedacode.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KedaCode 运行时",
        "url": "index.html",
        "width": 420,
        "height": 620,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "capabilities": ["menubar-panel"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.developer-tools",
    "shortDescription": "KedaCode 任务状态面板",
    "longDescription": "从 macOS 菜单栏查看 Agent Runner 状态并固定为悬浮窗。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
